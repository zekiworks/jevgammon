+    let setup = guarded(&guard_file(&dir, cap, &[("G", 1.0)]));
+    let g = player("G", &stub.url, 2, &setup).await.unwrap();
+    let (first, second) = (position.request(), position.request());
+    let (a, b) = tokio::join!(g.decide(&first), g.decide(&second));
+    assert_eq!(
+        stub.requests(),
