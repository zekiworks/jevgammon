+/* The leaderboard rows (Ümit, bus #2745): the maker dot, the setting, a row's other settings (shown without script, behind
+   the row's expander with it), the programs and late entries grey and unranked under a group heading. */
+table.headline td:nth-child(9) .small { max-width: 11rem; white-space: normal; }
+table.headline td.model .hl-dot { width: .7rem; height: .7rem; border-radius: 50%; }
+td.hl-setting { white-space: nowrap; }
+.hl-more { display: block; margin-top: .2rem; padding: 0; border: 0; background: none; color: var(--link, var(--text-2));
+  font: inherit; font-size: .8rem; cursor: pointer; text-decoration: underline dotted; }
+.hl-more::before { content: "\25B8\00a0"; }
+.hl-more[aria-expanded="true"]::before { content: "\25BE\00a0"; }
+tr.hl-sub[hidden] { display: table-row; }
+.js tr.hl-sub[hidden] { display: none; }
+tr.hl-sub td { background: var(--sunk); }
+tr.hl-sub td.model { padding-left: 1.6rem; }
