+.hl-val { font-family: var(--mono); font-size: .84rem; }
+td.hl-release { white-space: nowrap; }
+.js [data-headline-panel][hidden] { display: none; }
+.finding h2 { font-size: 1.25rem; }
+.finding-text { max-width: 80ch; margin: 0 0 .75rem; }
+.finding-chart { margin: 0; }
+.section-caveat { margin-top: .6rem; }
