-.card h3 { font-size: 1rem; margin: 1.1rem 0 .5rem; }
+.card h3 { font-size: var(--h3); margin: 1.1rem 0 .5rem; }
 .block { margin: 1rem 0 0; padding-top: .75rem; border-top: 1px dashed var(--edge); }
@@ -76,3 +87,3 @@
 .hero { max-width: none; margin: 0 0 1rem; }
-main > .card.hero h1 { font-size: 1.6rem; margin: 0 0 .5rem; letter-spacing: 0; }
+main > .card.hero h1 { font-size: var(--h1); margin: 0 0 .5rem; letter-spacing: 0; }
 .hero .intro { margin: 0 0 .6rem; font-size: 1rem; }
