+  border-radius: 2px; box-shadow: inset 0 0 0 1px var(--edge); }
+.hl-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 2px; box-shadow: inset 0 0 0 1px var(--mark-edge); }
+.hl-fill.other { background: var(--data-grey); }
