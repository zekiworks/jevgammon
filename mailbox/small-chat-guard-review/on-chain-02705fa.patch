   echo "$(date -u +%FT%TZ) == $k (serve $s)"
+  [[ ! -e $D/latch ]] || { echo "$(date -u +%FT%TZ) batch guard latched ($D/latch: $(tail -1 "$D/latch" | cut -c1-200)); chain stopped before $k"; exit 2; }
