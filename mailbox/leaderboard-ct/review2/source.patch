+.hbar-fill.ts-grey, i.swatch-ts-grey { background-color: var(--data-grey); }
+i.swatch-ts-safety, i.swatch-ts-found { background-color: var(--text-2); }
+.too-safe { margin-top: 1rem; }
+/* At phone width (Zeki #2790): the model, not the rank, is the sticky first column, and the bar column is narrower,
