 set -u
-J=/home/cbasaran/code/jevgammon; W=$HOME/.cache/jevgammon-wt/late-smallchat-on; B=$HOME/.cache/jevgammon-wt/target-late-smallchat-on/release/jevgammon
+J=/home/cbasaran/code/jevgammon
