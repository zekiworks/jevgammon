+struct Position {
+    board: Board,
+    plays: Vec<Play>,
+    notations: Vec<String>,
+    order: Vec<usize>,
+    retry: RetryTime,
+}
+
+impl Position {
+    /// A position with at least `min` legal plays.
+    fn with(min: usize) -> Self {
+        let mut board = Board::start();
+        board.pts[12] = 3;
+        board.pts[7] = 5;
+        let (plays, _) = [(2, 1), (1, 1), (2, 2), (3, 1), (4, 2), (3, 3)]
+            .iter()
+            .map(|&(a, b)| (board.legal_plays(a, b), (a, b)))
+            .find(|(p, _)| p.len() >= min)
+            .expect("a position with enough plays");
+        let notations = plays.iter().map(|p| p.notation()).collect();
+        let order = (0..plays.len()).rev().collect();
+        Position {
+            board,
+            plays,
+            notations,
+            order,
+            retry: RetryTime::default(),
+        }
+    }
+
+    fn request(&self) -> DecisionRequest<'_> {
+        DecisionRequest {
+            board: &self.board,
+            dice: (2, 1),
+            plays: &self.plays,
+            notations: &self.notations,
+            my_score: 0,
+            opp_score: 0,
+            round: 1,
+            rounds: 3,
+            leg: 1,
+            clock: None,
+            my_clock: None,
+            opp_clock: None,
+            turn_no: 1,
+            max_turns: None,
+            player: 1,
+            history: &[],
+            order: &self.order,
+            seed: 1,
+            version: PromptVersion::BgV2,
+            retry: &self.retry,
+        }
+    }
+}
