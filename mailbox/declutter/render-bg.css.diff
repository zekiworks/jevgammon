--- origin/main/bg.css
+++ declutter/bg.css
@@ -1,2 +1,13 @@
 /* Backgammon benchmark additions to the shared design system (site.css). */
+
+/* Heading sizes on every backgammon page (Ümit via Zeki #3521: no needlessly big type): the title one or two lines
+   at 1280 px and 375 px, h2 and h3 a step below it, body text as site.css sets it. These replace site.css's heading
+   sizes (.card h2, main > .card h1, .hero h1, .chart-head h2, .worked-example h2, .method-page .card h3) and the
+   browser's default for headings in a panel (Leagues' table titles); its result-card label (.result-card h2, .9rem)
+   stays as it was. */
+:root { --h1: clamp(1.05rem, 1.6vw, 1.35rem); --h2: clamp(1rem, 1.3vw, 1.12rem); --h3: .95rem; }
+main > .card h1, .hero h1 { font-size: var(--h1); }
+.card h2, .panel h2, .chart-head h2, .worked-example h2 { font-size: var(--h2); }
+.result-card h2 { font-size: .9rem; }
+.panel h3, .method-page .card h3 { font-size: var(--h3); }
 
@@ -13,3 +24,3 @@
